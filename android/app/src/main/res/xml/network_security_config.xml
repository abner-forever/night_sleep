<?xml version="1.0" encoding="utf-8"?>
<!-- 发布包不放行任何明文 HTTP。

     天气接口已换成 HTTPS 域名（基址由构建注入，见 `AppConfig.weatherApiBaseUrl`），
     原先为临时服务器 IP 开的那条例外已删除。
     targetSdk ≥ 28 默认**禁止**明文 HTTP，这里的 base-config 只是把「禁止」写死，
     防止将来某条 debug 覆盖被误合并进 release。

     这个文件仍然必须留在 main：清单里 `android:networkSecurityConfig` 指向它，
     release 找不到资源会构建失败；而 `src/debug/res/xml` 的同名文件靠覆盖它，
     才让本机调试放行 localhost / 10.0.2.2。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
