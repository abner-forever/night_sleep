<?xml version="1.0" encoding="utf-8"?>
<!-- debug 覆盖：发布配置禁止一切明文 HTTP，本机调试还要连
     10.0.2.2（Android 模拟器映射宿主机）与 localhost（adb reverse）。

     线上接口已换成 HTTPS 域名（基址由构建注入，见 `AppConfig.weatherApiBaseUrl`），
     原先为服务器 IP 开的那条例外已删除——这里只保留本机调试地址。

     设了 networkSecurityConfig 之后 `android:usesCleartextTraffic` 在 API 24+ 会被忽略，
     所以这几个本机地址必须写在这里，不能指望 debug 清单里的那条属性。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
