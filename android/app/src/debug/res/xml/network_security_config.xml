<?xml version="1.0" encoding="utf-8"?>
<!-- debug 覆盖：主配置只放行临时服务器 IP，本机调试还要连
     10.0.2.2（Android 模拟器映射宿主机）与 localhost（adb reverse）。

     设了 networkSecurityConfig 之后 `android:usesCleartextTraffic` 在 API 24+ 会被忽略，
     所以那几个本机地址必须写在这里，不能指望 debug 清单里的那条属性。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">110.40.226.136</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
