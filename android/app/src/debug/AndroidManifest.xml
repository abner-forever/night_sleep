<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 明文 HTTP 放行规则搬到 src/debug/res/xml/network_security_config.xml：
         targetSdk ≥ 28 且存在 networkSecurityConfig 时，android:usesCleartextTraffic
         会被忽略，写在这里不再起作用。debug 放行本机地址与临时服务器 IP，
         release 只放行服务器 IP（见 src/main/res/xml 的同名文件）。 -->
</manifest>
