# 本地开发用的编译期参数模板。复制成 .env.local 再填值，.env.local 不入库。
#
#   cp .env.local.example .env.local
#   tool/run_local.sh              # 等价于 flutter run --dart-define-from-file=.env.local
#
# 天气接口基址，必须带 /api 前缀、且是 https://（release 构建不允许明文 HTTP）。
# 留空时 App 不发天气请求，首页不显示天气卡。
# 例：WEATHER_API_BASE_URL=https://<你的服务端域名>/api
WEATHER_API_BASE_URL=
