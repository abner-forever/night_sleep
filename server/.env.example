# 应用配置
NODE_ENV=development
PORT=8080

# 允许跨域的站点，多个地址用逗号分隔。移动端请求不需要配置。
CORS_ORIGINS=http://localhost:5173

# 部署在反向代理后时填写代理层数，例如 1。
TRUST_PROXY=false

# 无 location 参数且请求 IP 无法公网定位时使用，便于模拟器联调。
# 留空时服务不会猜测城市。
# WEATHER_DEFAULT_LOCATION=上海

# 和风天气 JWT 认证（Ed25519）
# API Host 填控制台提供的域名，不带 https://
QWEATHER_API_HOST=
# 支持整段 PEM、\n 转义，或只填私钥中间内容
QWEATHER_PRIVATE_KEY=
QWEATHER_PROJECT_ID=
QWEATHER_KEY_ID=
# 控制台设置中的 Developer ID，JWT 的 iss
QWEATHER_DEVELOPER_ID=

# 上游超时与缓存
WEATHER_HTTP_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_TIME_ZONE=Asia/Shanghai

# 未提供城市参数时，用公开请求 IP 获取城市级位置
IP_GEOLOCATION_BASE_URL=https://ipwho.is
