# 夜深应用服务：Nginx 反向代理示例
#
# 目标：
#   https://xxx.com/api/*        → 本机 127.0.0.1:8080（正式服）
#   https://beta.xxx.com/api/*   → 本机 127.0.0.1:8081（测试服）
#
# 原生 Nginx：放到 /etc/nginx/conf.d/night-sleep.conf，然后 nginx -t && nginx -s reload。
# 宝塔面板：网站 → 添加站点 → 设置 → 反向代理，目标 URL 填 http://127.0.0.1:8080；
#          或把下面的 server 块粘进该站点的配置文件（/www/server/panel/vhost/nginx/）。
#
# 注意 proxy_pass 后面不要加尾斜杠：加了会把 /api 前缀去掉，后端收到的是 /weather。

server {
    listen 80;
    server_name xxx.com www.xxx.com;

    # 如果前面还有 CDN，按实际代理层数调整 .env 里的 TRUST_PROXY。
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}

server {
    listen 80;
    server_name beta.xxx.com;

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}

# HTTPS：宝塔在「网站 → SSL」申请 Let's Encrypt 即可；
# 原生 Nginx 可用：sudo certbot --nginx -d xxx.com -d www.xxx.com -d beta.xxx.com
